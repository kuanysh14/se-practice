@startuml
title SIS #04 Refactored Architecture (After)
component "App.tsx + components" as App
component "rooms.ts\n(Room, ROOMS)" as Rooms
component "filter.ts\n(filterRooms)" as Filter
component "booking.ts\n(canBook, checkRoom, getRejectionReasons)" as Booking
component "lib/availability.ts\n(checkAvailability)" as Avail

App --> Rooms : ROOMS
App --> Filter : filterRooms()
App --> Avail : checkAvailability()
Avail --> Booking : checkRoom(), getRejectionReasons()
Booking --> Rooms : Room type
Filter --> Rooms : Room type
@enduml